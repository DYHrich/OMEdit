{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug with GDB",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/install_cmake/bin/OMEdit",
            "args": [],
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb"
        }
    ]
}
